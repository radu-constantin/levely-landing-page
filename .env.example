# Copy to `.env` and fill in from Contentful → Settings → API keys.
# `.env` is gitignored. These same three values go into Render's
# Environment settings so the production build can read them.

CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master

# Content Delivery API — published entries only. Used for real builds.
CONTENTFUL_DELIVERY_TOKEN=

# Content Preview API — also returns drafts. Used by `npm run dev` only.
CONTENTFUL_PREVIEW_TOKEN=
