---
import BaseLayout from '../layouts/BaseLayout.astro';
import PotionVial from '../components/PotionVial.astro';
import SignupForm from '../components/SignupForm.astro';
import { getLatestEntry } from '../lib/contentful';

// Resolved at build time, so this always points at the newest entry rather
// than slowly rotting into a link to an old post.
const latest = await getLatestEntry();

const title = 'Levely — Level up your real-life skills';
const description =
  'A focus timer where your real-life skills level up like an RPG character. Follow the build, get founding access at launch.';
const successBody =
  "+50 XP for good taste. Founding access lands in your inbox at launch — I'll write to you from the trenches until then.";
---
<BaseLayout title={title} description={description} current="home">
  <main class="hero">
    <PotionVial />

    <section class="pitch-col">
      <div class="eyebrow">A focus app for main characters</div>

      <h1 class="headline">Level up your<br /><em>real-life</em> skills.</h1>

      <p class="hook">You're the main character. Start leveling.</p>

      <p class="pitch">Pick a skill you're actually trying to get better at &mdash; guitar, Spanish, deadlifts, whatever. Start a focus session and gain XP. You&rsquo;re the main character. Level up!</p>

      <SignupForm variant="inline" successBody={successBody} />

      <div class="footer-links">
        <a id="article-link" href={latest ? latest.href : '/journal/'}>Read the latest journal entry &rarr;</a>
        <span class="sep" aria-hidden="true">&#10022;</span>
        <a id="x-link" href="https://x.com/radu_codes">Follow my progress on X</a>
      </div>
    </section>
  </main>
</BaseLayout>
