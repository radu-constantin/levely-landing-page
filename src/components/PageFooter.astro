---
/** Footer for the long-form pages. The landing has its own, different one. */
interface Props {
  backHref: string;
  backLabel: string;
  handle?: string;
}

const { backHref, backLabel, handle = '@radu_codes' } = Astro.props;
const handleHref = `https://x.com/${handle.replace(/^@/, '')}`;
---
<footer class="page-footer">
  <a href={backHref}>&larr; {backLabel}</a>
  <span class="sep" aria-hidden="true">&#10022;</span>
  <a class="page-footer-muted" href={handleHref}>{handle} on X</a>
  <span class="page-footer-note">Written between builds.</span>
</footer>
