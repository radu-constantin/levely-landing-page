---
/**
 * Landing hero art: the XP vial inside its arcane rings, plus the skill
 * chips. `app.js` overwrites `--level` from its CONFIG block at runtime.
 */
interface Props {
  level?: number;
  skills?: { name: string; level: number }[];
}

const {
  level = 60,
  skills = [
    { name: 'Guitar', level: 4 },
    { name: 'Programming', level: 7 },
    { name: 'Writing', level: 6 },
    { name: 'French', level: 2 },
  ],
} = Astro.props;
---
<section class="potion-col">
  <div class="eyebrow-training"><span class="diamond">&#9671;</span> Now training &middot; Programming</div>

  <div class="potion-stage">
    <div class="ring ring-outer" aria-hidden="true">
      <svg viewBox="0 0 200 200" width="100%" height="100%">
        <circle cx="100" cy="100" r="96" fill="none" stroke="rgba(242,207,131,.32)" stroke-width="0.7" stroke-dasharray="1.5 7"></circle>
        <circle cx="100" cy="100" r="88" fill="none" stroke="rgba(242,207,131,.14)" stroke-width="0.5"></circle>
      </svg>
    </div>
    <div class="ring ring-inner" aria-hidden="true">
      <svg viewBox="0 0 200 200" width="100%" height="100%">
        <circle cx="100" cy="100" r="96" fill="none" stroke="rgba(95,240,163,.28)" stroke-width="0.6" stroke-dasharray="0.6 11"></circle>
      </svg>
    </div>

    <div class="aura" aria-hidden="true"></div>

    <span class="mote mote-xp1" aria-hidden="true">+12 XP</span>
    <span class="mote mote-star1" aria-hidden="true">&#10022;</span>
    <span class="mote mote-star2" aria-hidden="true">&#10023;</span>

    <div class="glass">
      <div class="glass-highlight" aria-hidden="true"></div>

      <div class="liquid" style={`--level: ${level}%;`}>
        <div class="wave" aria-hidden="true">
          <svg width="100%" height="32" viewBox="0 0 400 32" preserveAspectRatio="none">
            <path d="M0 13 C 50 2, 150 24, 200 13 C 250 2, 350 24, 400 13 L400 32 L0 32 Z" fill="#35dd85"></path>
          </svg>
        </div>
        <span class="bubble bubble-1" aria-hidden="true"></span>
        <span class="bubble bubble-3" aria-hidden="true"></span>
        <span class="bubble bubble-4" aria-hidden="true"></span>
      </div>
    </div>

    <div class="ground" aria-hidden="true"></div>
  </div>

  <div class="chips">
    {skills.map((skill) => (
      <span class="chip">
        <span class="chip-dot">&#9670;</span>{skill.name}<span class="chip-lv">LV&nbsp;{skill.level}</span>
      </span>
    ))}
  </div>
</section>
